# backend-server 의 deploy/backend/.env (이 파일을 복사해 값을 채움. .env 는 git 에 올리지 않음)

# ── EC2 저장 경로 (bootstrap 스크립트가 만듦) ──
STORAGE_HOST_DIR=/srv/t4core/storage
KOSIS_HOST_DIR=/srv/t4core/kosis_data
PG_HOST_DIR=/srv/t4core/pgdata
REDIS_HOST_DIR=/srv/t4core/redis

# ── backend-server PostgreSQL (통계값 kosis · 대화 이력 app) ──
PG_USER=t4core
PG_PASSWORD=
PG_DB=t4core

# ── db-server PostgreSQL + pgvector (임베딩 vec) — db-server 의 "프라이빗 IP" ──
# 예: VECTOR_DB_URL=postgresql://t4core_vector:비밀번호@172.31.10.20:5432/t4core_vector
VECTOR_DB_URL=

