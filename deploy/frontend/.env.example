# nginx가 실행 중에 사용할 백엔드 주소
BACKEND_UPSTREAM=backend:8000

# 프론트엔드 빌드 설정
VITE_API_BASE_PATH=/api/v1
VITE_USE_MOCK=false
VITE_USER_URL=/

# 관리자 화면 빌드 설정
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ADMIN_EMAIL_DOMAIN=team.local

# [NEW] KOS-58 HTTPS (인증서를 발급한 서버에서만 설정, 비우면 HTTP)
# NGINX_TEMPLATE_DIR=/etc/nginx/templates-tls
# TLS_CERT_NAME=<인증서 폴더 이름. IP 인증서는 고정 IP>