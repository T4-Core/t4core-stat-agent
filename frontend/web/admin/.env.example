# 이 파일을 복사해 admin/.env.local 을 만드세요. 관리자 페이지는 이 폴더의 설정만 읽습니다.

# FastAPI 백엔드 주소
BACKEND_URL=http://localhost:8000
VITE_API_BASE_PATH=/api/v1

# 관리자 테스트는 실제 백엔드를 호출합니다 (HCX 비용 발생)
VITE_USE_MOCK=false

# Supabase 프로젝트 URL과 공개용 키(publishable 또는 anon).
# service_role / secret 키는 모든 권한을 가지므로 절대 넣지 마세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 아이디 뒤에 자동으로 붙는 가짜 이메일 주소. Supabase 계정도 아이디@team.local 로 만듭니다.
VITE_ADMIN_EMAIL_DOMAIN=team.local

# 왼쪽 위 T4core 를 누르면 여는 사용자 화면 주소. 개발 중에는 비워 두면 5173번 포트를 사용합니다.
VITE_USER_URL=
