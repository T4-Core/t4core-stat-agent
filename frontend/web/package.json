{
  "name": "kosis-stat-agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:api": "node scripts/generate-api-types.mjs",
    "admin": "vite --config admin/vite.config.ts",
    "build:admin": "tsc -p admin/tsconfig.json --noEmit && vite build --config admin/vite.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "plotly.js-dist-min": "^4.3.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^6.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9",
    "vite": "^8.3.8"
  }
}
