# [CHANGED] KOS-58 이전: server 블록 안에 location 을 직접 정의, proxy_pass http://${BACKEND_UPSTREAM}
# HTTP 전용 (로컬·CI 기본값). 공통 location 은 app-locations.conf
upstream backend_app {
    server ${BACKEND_UPSTREAM};
}

server {
    listen 80;
    root /usr/share/nginx/html;

    # [NEW] KOS-58 Let's Encrypt HTTP-01 검증 파일 (certbot webroot)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    include /etc/nginx/app-locations.conf;
}