# [NEW] KOS-58 HTTPS 설정. NGINX_ENVSUBST_TEMPLATE_DIR 로 선택한다
upstream backend_app {
    server ${BACKEND_UPSTREAM};
}

server {
    listen 80;

    # 인증서 갱신 검증은 80 에서 계속 받는다
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    # 배포 헬스 체크(deploy.sh, CI 스모크 테스트)가 http://localhost/health 를 호출한다
    location = /health {
        proxy_pass http://backend_app;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    root /usr/share/nginx/html;

    ssl_certificate     /etc/letsencrypt/live/${TLS_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${TLS_CERT_NAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:TLS:10m;

    include /etc/nginx/app-locations.conf;
}