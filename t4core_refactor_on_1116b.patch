-    "# ============= 5. 대시보드용 중간 결과 저장 (HCX 호출 없음) ================\n",
-    "# 질문마다 1 → 2-1 → 2-2 → 2-3 → 2-4 → 3 → 4 단계의 중간 결과를 모아 저장\n",
-    "#   rewrite_trace.json : 중간 결과 (사람이 읽거나 다른 코드에서 쓸 때)\n",
-    "#   rewrite_trace.js   : 같은 내용 (rewrite_pipeline_dashboard.html 이 서버 없이 바로 읽음)\n",
-    "import json\n",
-    "from dataclasses import asdict\n",
-    "from datetime import date, datetime\n",
-    "from pathlib import Path\n",
-    "\n",
-    "TRACE_JSON = Path(\"rewrite_trace.json\")\n",
-    "TRACE_JS = Path(\"rewrite_trace.js\")\n",
-    "\n",
-    "\n",
-    "def build_trace():\n",
-    "    items = []\n",
-    "    for i, (r, v, sres, b) in enumerate(zip(SLOT_RESULTS, VALID_RESULTS, SENTENCE_RESULTS, BUNDLES), 1):\n",
-    "        items.append({\n",
-    "            \"no\": i,\n",
-    "            \"question\": r[\"question\"],                                         # 1. 사용자 질문\n",
-    "            \"term_hits\": [[a, list(t)] for a, t in r.get(\"term_hits\", [])],     # 2-1. 용어 사전\n",
-    "            \"input_question\": r[\"input_question\"],                             # 2-2. 코드 추출\n",
-    "            \"time_notes\": r.get(\"time_notes\", []),\n",
-    "            \"rule_found\": r.get(\"rule_found\", {}),\n",
-    "            \"user_prompt\": r[\"messages\"][1][\"content\"],                        # 2-3. HCX 슬롯 추출\n",
-    "            \"hcx_out\": r.get(\"hcx_out\"),\n",
-    "            \"hcx_slots\": r.get(\"hcx_slots\"),\n",
-    "            \"hcx_subs\": r.get(\"hcx_subs\", []),\n",
-    "            \"parsed\": r.get(\"parsed\"),\n",
-    "            \"error\": r.get(\"error\", \"\"),\n",
-    "            \"elapsed_s\": r.get(\"elapsed_s\"),\n",
-    "            \"valid_slots\": v[\"slots\"],                                         # 2-4. 슬롯 검증\n",
-    "            \"valid_subs\": v[\"sub_slots\"],\n",
-    "            \"valid_log\": v[\"log\"],\n",
-    "            \"rewritten\": sres[\"rewritten\"],                                    # 3. 슬롯 → 문장\n",
-    "            \"sub_questions\": sres[\"sub_questions\"],\n",
-    "            \"bundle\": asdict(b),                                               # 4. QueryBundle\n",
-    "        })\n",
-    "    meta = {\n",
-    "        \"created\": datetime.now().isoformat(timespec=\"seconds\"),\n",
-    "        \"model\": CHAT_MODEL,\n",
-    "        \"today\": str(TODAY or date.today()),\n",
-    "        \"source\": str(QUERY_PATH),\n",
-    "        \"n\": len(items),\n",
-    "        \"slot_keys\": SLOT_KEYS,\n",
-    "        \"system_prompt\": SLOT_RESULTS[0][\"messages\"][0][\"content\"] if SLOT_RESULTS else \"\",\n",
-    "    }\n",
-    "    return {\"meta\": meta, \"items\": items}\n",
-    "\n",
-    "\n",
-    "TRACE = build_trace()\n",
-    "_text = json.dumps(TRACE, ensure_ascii=False, indent=1)\n",
-    "TRACE_JSON.write_text(_text, encoding=\"utf-8\")\n",
