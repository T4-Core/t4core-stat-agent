-    "AGE_WORD_MAP = {\"노인\": \"65세 이상\", \"고령자\": \"65세 이상\", \"고령\": \"65세 이상\", \"어르신\": \"65세 이상\"}\n",
-    "AGE_FORMAT = re.compile(r\"\\d+~\\d+세|\\d+세 (?:이상|이하|미만|초과)|\\d+세\")\n",
-    "TERM_AGE = re.compile(r\"^(\\d+~\\d+세|\\d+세 (?:이상|이하|미만|초과))\\s*(.+)$\")   # '65세 이상 인구' → 연령 + 대상\n",
-    "\n",
-    "\n",
-    "def _as_list(v):\n",
