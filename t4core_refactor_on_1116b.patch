-   "source": "def side_by_side(query, filters=None, configs=(\"baseline\", \"bm25_only\", \"hybrid_rrf_hcx\"), top_k=5, overrides=None):\n    cols = {}\n    for c in configs:                       # 이름 또는 dict 구성\n        name = c if isinstance(c, str) else c.get(\"name\", \"inline\")\n        try:\n            hs = get_pipeline(c, (overrides or {}).get(name)).search(query, filters, top_k)[\"hits\"]\n            cols[name] = [f\"{h['tbl_nm'][:22]} ({h['tbl_id']})\" for h in hs] + [\"\"] * (top_k - len(hs))\n        except Exception as e:\n            cols[name] = [f\"오류: {e}\"] + [\"\"] * (top_k - 1)\n    return pd.DataFrame(cols, index=range(1, top_k + 1))\n\nside_by_side(Q, F, [\"baseline\", \"bm25_only\", \"kiwi_lexicon\", \"char_ngram\", \"hybrid_rrf_hcx\", \"ensemble_rrf\"])",
