-    "    s[\"의도\"] = intents if main else intents[0]\n",
-    "    return s, log\n",
-    "\n",
-    "\n",
-    "# ---- 2) 사전 대표 용어 ----\n",
-    "def apply_terms(s):\n",
-    "    \"\"\"대상·지표 값을 2-1 사전의 대표 용어로.\n",
-    "    대표 용어가 연령 자체면('노인' → '65세 이상') 연령 슬롯으로 옮기고, 그 때문에 대상이 비면 '인구'를 넣음\n",
