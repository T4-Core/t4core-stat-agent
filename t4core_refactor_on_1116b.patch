-    "    path = Path(path)\n",
-    "    path.write_text(json.dumps([asdict(b) for b in bundles], ensure_ascii=False, indent=1), encoding=\"utf-8\")\n",
-    "    print(f\"저장: {path.resolve()} ({len(bundles)}개)\")\n",
-    "    return path\n",
-    "\n",
-    "\n",
-    "def load_bundles(path=SAVE_PATH):\n",
