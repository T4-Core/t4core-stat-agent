-    def predict(self, pairs, batch_size=16, show_progress_bar=False):
-        ST_CALLS["predict"] += len(pairs)
-        return np.array([len(_bigrams(q) & _bigrams(d)) / max(len(_bigrams(q)), 1) * 10 - 5 for q, d in pairs])
