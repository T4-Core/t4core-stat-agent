# 이 파일을 복사해서 .env 를 만들고 실제 키를 넣으세요:  cp .env.example .env
# .env 는 git 에 올라가지 않습니다. 이 파일(.env.example)에는 실제 키를 넣지 마세요.

# ── KOSIS OpenAPI ─────────────────────────────────────────
# 발급: https://kosis.kr/openapi → 활용신청 → 인증키 확인
KOSIS_API_KEY=your-kosis-api-key

# ── HCX (HyperCLOVA X, NAVER Cloud CLOVA Studio) ─────────
# 발급: CLOVA Studio 콘솔 → API 키 관리 → 테스트/서비스 API 키 생성
HCX_API_KEY=nv-your-clova-studio-api-key
# OpenAI 호환 엔드포인트 (openai 패키지로 호출할 때 base_url 로 사용)
HCX_BASE_URL=https://clovastudio.stream.ntruss.com/v1/openai
# 사용할 모델명 (CLOVA Studio 콘솔에서 사용 가능한 모델 확인)
HCX_MODEL=HCX-005
