# 이 파일을 복사해서 .env 를 만들고 실제 키를 넣으세요:  cp .env.example .env
# .env 는 git 에 올라가지 않습니다. 이 파일(.env.example)에는 실제 키를 넣지 마세요.
# .env 는 저장소 루트(또는 상위 폴더)에 두면 backend/core/config.py 가 한 번 읽습니다.

# ── KOSIS OpenAPI ─────────────────────────────────────────
# 발급: https://kosis.kr/openapi → 활용신청 → 인증키 확인
KOSIS_API_KEY=your-kosis-api-key

# ── HCX (HyperCLOVA X, NAVER Cloud CLOVA Studio) ─────────
# 발급: CLOVA Studio 콘솔 → API 키 관리 → 테스트/서비스 API 키 생성
HCX_API_KEY=nv-your-clova-studio-api-key
# 호스트까지만 써도 되고 경로까지 써도 됨 (코드가 호스트만 사용)
HCX_BASE_URL=https://clovastudio.stream.ntruss.com
# 사용할 모델명 (CLOVA Studio 콘솔에서 사용 가능한 모델 확인)
HCX_MODEL=HCX-007
HCX_APP_TYPE=testapp
# HCX_EMBED_PATH=/v1/api-tools/embedding/v2

# ── [v4] View 충돌 선택 토큰 서명 키 (선택) ─────────────────
# 서버를 여러 대 띄우면 같은 값을 넣어야 한 서버가 발급한 선택 토큰을 다른 서버가 받음.
# 비우면 storage/.view_selection_secret 를 처음 한 번 만들어 씀
# VIEW_SELECTION_SECRET=
